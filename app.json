{
  "expo": {
    "name": "SYNA Tồn Kho",
    "slug": "customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/syna-app-icon.png",
    "scheme": "customerapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/syna-app-icon.png",
      "bundleIdentifier": "vn.syna.inventory",
      "buildNumber": "1"
    },
    "android": {
      "package": "vn.syna.inventory",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/syna-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/syna-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 240,
          "android": {
            "image": "./assets/images/syna-app-icon.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91e44714-11c2-42d4-b35f-86aaa2e4aa66"
      }
    },
    "owner": "namnguyenndevs-team"
  }
}
